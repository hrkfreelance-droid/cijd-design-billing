# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
# Set these three and the app switches from the local JSON store to Supabase,
# with Supabase Auth for sign-in. Leave them empty for local development.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the Telegram endpoint, which has no browser session.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather.
# TELEGRAM_BOT_TOKEN=
# Any random string; the bot endpoint is disabled without it.
# TELEGRAM_WEBHOOK_SECRET=
# Chat ID that receives delivery notifications (Daiki Terashima).
# Not known yet — leave unset until confirmed. Never put a placeholder here.
# TELEGRAM_BILLING_CHAT_ID=
# Name recorded for work registered from Telegram.
# TELEGRAM_ACTOR=Hiroki

# ── Local development ───────────────────────────────────────────────────────
# Where the local JSON store lives (ignored when Supabase is configured).
# CIJD_DATA_FILE=.data/db.json
# Browser-only demo data for a public preview. Disables the API routes.
# NEXT_PUBLIC_DEMO_MODE=1
