# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
# Set these two and the app switches from the local JSON store to Supabase,
# with Supabase Auth + Google OAuth for sign-in. Leave them empty for local development.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by secret access-link sessions to reach the shared DB.
# Never expose this to the browser. Google sessions do not need this key.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Secret access links ─────────────────────────────────────────────────────
# The flag can later be set to 0 to disable every access link without changing
# the role matrix or the shared data. Token values belong in Cloudflare Secrets
# (or .env.local for local testing), never in Git.
# CIJD_ACCESS_LINKS_ENABLED=1
# CIJD_ADMIN_ACCESS_TOKEN=
# CIJD_DESIGNER_ACCESS_TOKEN=
# CIJD_PRINTING_ACCESS_TOKEN=
# CIJD_BILLING_ACCESS_TOKEN=
# CIJD_ACCOUNTING_ACCESS_TOKEN=

# ── Local development ───────────────────────────────────────────────────────
# Where the local JSON store lives (ignored when Supabase is configured).
# CIJD_DATA_FILE=.data/db.json
# Browser-only demo data for local UI review only. Disables the API routes.
# NEXT_PUBLIC_DEMO_MODE=1
