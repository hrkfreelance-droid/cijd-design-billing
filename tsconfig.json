{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    // tests/unit run through Node's own type stripping, which resolves the
    // real .ts files it imports.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next-local/types/**/*.ts",
    ".next-local/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts",
    "/private/tmp/cijd-next-test/types/**/*.ts",
    "/private/tmp/cijd-next-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "legacy/**",
    ".next 2",
    ".next/**/* 2.ts",
    ".next-local/**/* 2.ts"
  ]
}
