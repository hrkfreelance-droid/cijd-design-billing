{
  "name": "cijd-design-billing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "CIJD_NEXT_DIST_DIR=.next-local next dev",
    "preview:codespaces": "NEXT_PUBLIC_DEMO_MODE=1 NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_ANON_KEY= SUPABASE_SERVICE_ROLE_KEY= TELEGRAM_BOT_TOKEN= TELEGRAM_WEBHOOK_SECRET= TELEGRAM_BILLING_CHAT_ID= CIJD_NEXT_DIST_DIR=.next-codespaces next dev --hostname 0.0.0.0 --port 3000",
    "build": "CIJD_NEXT_DIST_DIR=.next-local next build --webpack",
    "start": "CIJD_NEXT_DIST_DIR=.next-local next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "playwright test",
    "test:import": "node --test scripts/import-history.test.mjs",
    "test:auth": "node --test scripts/supabase-user.test.mjs",
    "supabase:user": "node scripts/supabase-user.mjs",
    "shots": "node scripts/shots.mjs",
    "telegram": "node scripts/telegram-bot.mjs",
    "import:history": "node scripts/import-history.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
