{
  "name": "cijd-design-billing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "CIJD_NEXT_DIST_DIR=.next-local next dev",
    "build": "CIJD_NEXT_DIST_DIR=.next-local next build --webpack",
    "start": "CIJD_NEXT_DIST_DIR=.next-local next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "playwright test",
    "test:import": "node --test scripts/import-history.test.mjs",
    "test:auth": "node --test scripts/supabase-user.test.mjs",
    "supabase:user": "node scripts/supabase-user.mjs",
    "shots": "node scripts/shots.mjs",
    "import:history": "node scripts/import-history.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
