{
  // CIJD Billing V5 — its own Worker and its own D1 database.
  // Never the V3 Worker (cijd-design-billing-preview) or V4
  // (cijd-design-billing-v4-preview). No Supabase variables: V5 cannot reach V3's data.
  // Deploy with scripts/deploy-v5.sh.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cijd-design-billing-v5-preview",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  // NBC USD/KHR into V5's own D1, as V3 does into Supabase (UTC; Phnom Penh
  // 16:35 / 16:50 / 17:05 on weekdays and an 08:00 daily check).
  "triggers": {
    "crons": ["35 9 * * 1-5", "50 9 * * 1-5", "5 10 * * 1-5", "0 1 * * *"]
  },
  "vars": {
    "CIJD_V5_MODE": "1",
    "CIJD_PILOT_MODE": "1",
    "CIJD_PREVIEW_MODE": "1"
  },
  "d1_databases": [
    {
      "binding": "V5_DB",
      "database_name": "cijd-design-billing-v5-preview",
      // Replaced by scripts/deploy-v5.sh with the id of the V5 database it creates.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations-v5"
    }
  ],
  // Customer company documents (internal only, never on a Tax Invoice): V5's own
  // private bucket, not shared with V3 or V4. Created by scripts/deploy-v5.sh.
  "r2_buckets": [
    {
      "binding": "V5_DOCS",
      "bucket_name": "cijd-design-billing-v5-customer-documents"
    }
  ],
  "cache": {
    "enabled": true
  }
}
