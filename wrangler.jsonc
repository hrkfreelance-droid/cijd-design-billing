{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cijd-design-billing-preview",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "vars": {
    "CIJD_PREVIEW_MODE": "1",
    "CIJD_ACCESS_LINKS_ENABLED": "1"
  },
  "cache": {
    "enabled": true
  }
}
